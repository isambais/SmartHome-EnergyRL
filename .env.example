# ── Veritabanı ───────────────────────────────────────────────
# PostgreSQL (docker-compose ile birlikte gelen varsayılan):
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smarthome
# Postgres kurmak istemezsen yerel SQLite ile de çalışır (bu satırı sil/yorumla):
# DATABASE_URL=sqlite:///./smarthome.db

# Token imzalama anahtarı — rastgele uzun bir değerle değiştir:
SECRET_KEY=degistir-bunu-uzun-rastgele-bir-deger

# ── EPİAŞ Şeffaflık Platformu (isteğe bağlı) ─────────────────
# Doldurulursa gün öncesi fiyatlar canlı EPİAŞ API'sinden çekilir.
# Boş bırakılırsa data/epias_combined.csv arşiv verisi kullanılır.
EPIAS_USER=
EPIAS_PASS=
